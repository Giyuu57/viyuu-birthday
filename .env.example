# ---- server/.env ----
# Copy this file to server/.env and adjust as needed.
# The site works perfectly with NO database configured — MONGO_URI is optional.

# Port the Express API runs on
PORT=5000

# The origin allowed to call the API (Vite's dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Optional: only needed if you want content persisted in MongoDB instead of
# just edited in client/src/data/content.ts. Leave blank to skip the database
# entirely — everything still works.
# Example (MongoDB Atlas): mongodb+srv://user:password@cluster.mongodb.net/viyuu
MONGO_URI=
